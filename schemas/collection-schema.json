{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User Collection",
  "description": "User-created collection of tools and L-Boxx organization",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^collection-[a-z0-9-]+$",
      "description": "Unique collection identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Collection name"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "Collection description/purpose"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 creation timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 last update timestamp"
    },
    "category": {
      "type": "string",
      "description": "Collection category (e.g., 'electrician', 'plumber', 'carpenter')"
    },
    "lboxx": {
      "type": "object",
      "description": "Associated L-Boxx configuration",
      "properties": {
        "id": {
          "type": "string",
          "description": "L-Boxx variant ID"
        },
        "inlays": {
          "type": "array",
          "description": "Inlays used in this configuration",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "description": "Tools and items in this collection",
      "items": {
        "type": "object",
        "required": ["id", "toolId"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^item-[a-z0-9-]+$",
            "description": "Unique item identifier within collection"
          },
          "toolId": {
            "type": "string",
            "description": "Reference to tool catalog ID"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Number of this tool in collection"
          },
          "location": {
            "type": "string",
            "description": "Where tool is stored (e.g., 'Drawer 2, Slot 3')"
          },
          "condition": {
            "type": "string",
            "enum": ["perfect", "good", "fair", "needs-repair"],
            "default": "good",
            "description": "Tool condition status"
          },
          "notes": {
            "type": "string",
            "maxLength": 300,
            "description": "Personal notes about this tool"
          },
          "customAttributes": {
            "type": "object",
            "description": "User-defined attributes",
            "additionalProperties": {
              "type": ["string", "number", "boolean"]
            }
          }
        }
      }
    },
    "favorites": {
      "type": "array",
      "description": "Favorited tool IDs",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "description": "User-defined tags for organization",
      "items": {
        "type": "string",
        "maxLength": 30
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata",
      "properties": {
        "shared": {
          "type": "boolean",
          "description": "Is this collection shared?"
        },
        "sharedWith": {
          "type": "array",
          "description": "Email addresses this is shared with",
          "items": {
            "type": "string",
            "format": "email"
          }
        },
        "public": {
          "type": "boolean",
          "description": "Is this collection publicly viewable?"
        },
        "archived": {
          "type": "boolean",
          "default": false,
          "description": "Is collection archived?"
        },
        "totalValue": {
          "type": "number",
          "description": "Estimated total value in currency"
        },
        "estimatedWeight": {
          "type": "number",
          "description": "Estimated total weight in kg"
        }
      }
    },
    "exportFormat": {
      "type": "string",
      "enum": ["json", "csv", "pdf"],
      "description": "Format used for export (informational)"
    }
  },
  "required": ["id", "name", "createdAt", "items"],
  "additionalProperties": false
}
