{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bosch Tools Catalog Schema",
  "description": "Master catalog of Bosch professional tools with complete specifications (50+ fields per tool)",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic versioning (e.g., 1.0.0)",
      "example": "1.0.0"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "totalTools": {
      "type": "integer",
      "minimum": 0,
      "description": "Total count of tools in catalog"
    },
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "description": "List of all available tool categories",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "Power Drills",
          "Impact Drivers",
          "Angle Grinders",
          "Circular Saws",
          "Orbital Sanders",
          "Jigsaws",
          "Belt Sanders",
          "Grinders",
          "Hammers & Drills",
          "Multi-Tools",
          "Measuring Tools",
          "Laser Levels",
          "Work Lights",
          "Batteries & Chargers",
          "Accessories"
        ]
      }
    },
    "tools": {
      "type": "array",
      "description": "Array of tool objects (minimum 50 fields per tool when complete)",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "type", "productCode", "description"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 5,
            "maxLength": 50,
            "description": "Unique tool identifier (lowercase, hyphens only, globally unique)",
            "example": "bosch-gws-18v-125"
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "description": "Official Bosch tool name including model number",
            "example": "Bosch GWS 18V-125 Angle Grinder"
          },
          "category": {
            "type": "string",
            "enum": [
              "Power Drills",
              "Impact Drivers",
              "Angle Grinders",
              "Circular Saws",
              "Orbital Sanders",
              "Jigsaws",
              "Belt Sanders",
              "Grinders",
              "Hammers & Drills",
              "Multi-Tools",
              "Measuring Tools",
              "Laser Levels",
              "Work Lights",
              "Batteries & Chargers",
              "Accessories"
            ],
            "description": "Primary tool category"
          },
          "type": {
            "type": "string",
            "enum": ["cordless", "corded", "pneumatic", "manual", "battery", "charger"],
            "description": "Tool power type"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500,
            "description": "Detailed tool description including use cases"
          },
          "productCode": {
            "type": "string",
            "pattern": "^[0-9A-Z]{8,12}$",
            "description": "Official Bosch product code/SKU"
          },
          "modelNumber": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30,
            "description": "Full model number (e.g., GSR 18V-EC)"
          },
          "manufacturer": {
            "type": "string",
            "default": "Bosch",
            "description": "Tool manufacturer"
          },
          "releaseYear": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2030,
            "description": "Year tool was released or first available"
          },
          "availability": {
            "type": "string",
            "enum": ["in-stock", "discontinued", "pre-order", "coming-soon"],
            "default": "in-stock",
            "description": "Current product availability status"
          },
          "specifications": {
            "type": "object",
            "description": "Technical specifications (20+ fields for complete tools)",
            "additionalProperties": false,
            "properties": {
              "voltage": {
                "type": "string",
                "description": "Battery voltage for cordless tools",
                "example": "18V"
              },
              "power": {
                "type": "string",
                "description": "Power rating (W for corded, W equivalent for cordless)",
                "example": "900W"
              },
              "speed": {
                "type": "string",
                "description": "Operating speed (RPM or strokes per minute)",
                "example": "3000 RPM"
              },
              "maxTorque": {
                "type": "string",
                "description": "Maximum torque rating for impact/drill tools",
                "example": "170 Nm"
              },
              "noLoad": {
                "type": "string",
                "description": "No-load speed or other performance metric",
                "example": "3500 RPM"
              },
              "discSize": {
                "type": "string",
                "description": "Disc or blade size for cutting/grinding tools",
                "example": "125mm"
              },
              "chuckSize": {
                "type": "string",
                "description": "Chuck or collet size for drills/rotary tools",
                "example": "13mm"
              },
              "strokeLength": {
                "type": "string",
                "description": "Stroke length for orbital/reciprocating tools",
                "example": "28mm"
              },
              "orbitDiameter": {
                "type": "string",
                "description": "Orbit diameter for sanders",
                "example": "125mm"
              },
              "dustCapacity": {
                "type": "string",
                "description": "Built-in dust collection capacity",
                "example": "1.2L"
              },
              "weight": {
                "type": "string",
                "description": "Tool weight with battery (for cordless)",
                "example": "2.5 kg"
              },
              "weightWithoutBattery": {
                "type": "string",
                "description": "Tool weight without battery for cordless tools",
                "example": "1.8 kg"
              },
              "dimensions": {
                "type": "object",
                "description": "Overall tool dimensions",
                "additionalProperties": false,
                "properties": {
                  "length": {
                    "type": "object",
                    "properties": {
                      "value": { "type": "number" },
                      "unit": { "type": "string", "enum": ["mm", "cm", "in"] }
                    }
                  },
                  "width": {
                    "type": "object",
                    "properties": {
                      "value": { "type": "number" },
                      "unit": { "type": "string", "enum": ["mm", "cm", "in"] }
                    }
                  },
                  "height": {
                    "type": "object",
                    "properties": {
                      "value": { "type": "number" },
                      "unit": { "type": "string", "enum": ["mm", "cm", "in"] }
                    }
                  }
                }
              },
              "batteryRuntime": {
                "type": "string",
                "description": "Estimated runtime on full charge with standard battery",
                "example": "30-60 minutes"
              },
              "chargeTime": {
                "type": "string",
                "description": "Time to fully charge standard battery",
                "example": "30 minutes"
              },
              "soundLevel": {
                "type": "string",
                "description": "Sound pressure level in decibels",
                "example": "92 dB"
              },
              "vibration": {
                "type": "string",
                "description": "Vibration level (m/s²)",
                "example": "8.5 m/s²"
              },
              "brakingTime": {
                "type": "string",
                "description": "Time to stop after trigger release",
                "example": "<1 second"
              }
            }
          },
          "dimensions": {
            "type": "object",
            "description": "Physical dimensions for storage compatibility",
            "additionalProperties": false,
            "properties": {
              "length": {
                "type": "object",
                "required": ["value", "unit"],
                "properties": {
                  "value": { "type": "number", "minimum": 0 },
                  "unit": { "type": "string", "enum": ["mm", "cm", "in"] }
                }
              },
              "width": {
                "type": "object",
                "required": ["value", "unit"],
                "properties": {
                  "value": { "type": "number", "minimum": 0 },
                  "unit": { "type": "string", "enum": ["mm", "cm", "in"] }
                }
              },
              "height": {
                "type": "object",
                "required": ["value", "unit"],
                "properties": {
                  "value": { "type": "number", "minimum": 0 },
                  "unit": { "type": "string", "enum": ["mm", "cm", "in"] }
                }
              }
            }
          },
          "weight": {
            "type": "object",
            "description": "Tool weight for L-Boxx capacity planning",
            "required": ["value", "unit"],
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 50,
                "description": "Weight value"
              },
              "unit": {
                "type": "string",
                "enum": ["kg", "lbs"],
                "default": "kg"
              }
            }
          },
          "batteryCompatible": {
            "type": "array",
            "description": "Compatible battery series/types",
            "items": {
              "type": "string"
            },
            "example": ["CoolPack", "ProCORE"]
          },
          "accessories": {
            "type": "array",
            "description": "IDs of compatible accessories (references to tool catalog)",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "fits": {
            "type": "array",
            "description": "Compatible L-Boxx compartment sizes for storage",
            "items": {
              "type": "string",
              "enum": ["mini", "small", "medium", "large", "xl"]
            },
            "minItems": 1
          },
          "bestFor": {
            "type": "array",
            "description": "Recommended use cases and applications",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 30
            },
            "example": ["grinding", "cutting", "polishing"]
          },
          "tags": {
            "type": "array",
            "description": "Searchable tags for filtering and categorization",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 30
            },
            "example": ["professional", "cordless", "18v", "compact"]
          },
          "features": {
            "type": "array",
            "description": "Key features and technologies (ergonomics, safety, etc.)",
            "items": {
              "type": "string"
            },
            "example": ["anti-vibration", "electronic-speed-control", "soft-grip"]
          },
          "price": {
            "type": "object",
            "description": "Pricing information",
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "description": "Price in currency"
              },
              "currency": {
                "type": "string",
                "enum": ["EUR", "USD", "GBP"],
                "default": "EUR"
              },
              "includesTax": {
                "type": "boolean",
                "default": true
              }
            }
          },
          "warranty": {
            "type": "object",
            "description": "Warranty information",
            "additionalProperties": false,
            "properties": {
              "duration": {
                "type": "string",
                "description": "Warranty period (e.g., 2 years)",
                "example": "2 years"
              },
              "coverage": {
                "type": "string",
                "description": "What is covered under warranty"
              }
            }
          },
          "image": {
            "type": "string",
            "format": "uri",
            "description": "Product image URL"
          },
          "images": {
            "type": "array",
            "description": "Additional product images",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "manual": {
            "type": "string",
            "format": "uri",
            "description": "Link to PDF manual/user guide"
          },
          "safetyInfo": {
            "type": "string",
            "format": "uri",
            "description": "Link to safety documentation"
          },
          "dataSheet": {
            "type": "string",
            "format": "uri",
            "description": "Link to technical datasheet"
          },
          "incompatibilities": {
            "type": "array",
            "description": "Known incompatibilities or limitations",
            "items": {
              "type": "string"
            }
          },
          "replacementParts": {
            "type": "array",
            "description": "IDs of common replacement parts",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "relatedTools": {
            "type": "array",
            "description": "IDs of related or complementary tools",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "notes": {
            "type": "string",
            "maxLength": 500,
            "description": "Additional notes, tips, or recommendations"
          },
          "certifications": {
            "type": "array",
            "description": "Safety and compliance certifications",
            "items": {
              "type": "string"
            },
            "example": ["CE", "GS", "TÜV"]
          },
          "sustainabilityInfo": {
            "type": "object",
            "description": "Environmental and sustainability information",
            "additionalProperties": false,
            "properties": {
              "recyclable": {
                "type": "boolean",
                "description": "Is the tool recyclable?"
              },
              "energyClass": {
                "type": "string",
                "description": "Energy efficiency class"
              },
              "material": {
                "type": "string",
                "description": "Primary materials used"
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp when this tool was added to catalog"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of last modification"
          }
        }
      }
    }
  },
  "required": ["version", "lastUpdated", "tools"],
  "additionalProperties": false
}
